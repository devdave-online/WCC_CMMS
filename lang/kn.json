    "about.core_arch": "\/\/ CORE_SYSTEM_ARCHITECTURE \/\/",
    "about.core_engine_by": "ಕೋರ್ ಇಂಜಿನ್ ಮತ್ತು ಆರ್ಕಿಟೆಕ್ಚರ್ ಮೂಲಕ",
    "about.docs": "Webapp ಡಾಕ್ಯುಮೆಂಟೇಶನ್",
    "about.email_visible_hint": "Or just copy the address:",
    "about.feat.analytics": "ರಿಯಲ್-ಟೈಮ್ KPI & MTTR Analytics",
    "about.feat.analytics_body": "ರಿಪೇರಿ ಮಾಡಲು ಸರಾಸರಿ ಸಮಯವನ್ನು MTTR, ಡೌನ್‌ಟೈಮ್ ಟ್ರ್ಯಾಕ್ ಮಾಡಲು, ತಂತ್ರಜ್ಞರ ಕೆಲಸದ ಹೊರೆಯನ್ನು ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಲು ಮತ್ತು ಕಾಲಾನಂತರದಲ್ಲಿ ಭಾಗಗಳ ಬಳಕೆಯನ್ನು ದೃಶ್ಯೀಕರಿಸಲು ಕಚ್ಚಾ ಹಸ್ತಕ್ಷೇಪದ ಟೆಲಿಮೆಟ್ರಿಯನ್ನು ಒಟ್ಟುಗೂಡಿಸುತ್ತದೆ.",
    "about.feat.assets": "ಸಮಗ್ರ ಆಸ್ತಿ & BOM ನೋಂದಣಿ",
    "about.feat.assets_body": "ಸ್ವಯಂ-ಉಲ್ಲೇಖದ ಶ್ರೇಣಿಯ ಮೂಲಕ ಕೋರ್ CMMS ಘಟಕದ ರಚನೆಯನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ. ಬಿಲ್ ಆಫ್ ಮೆಟೀರಿಯಲ್ಸ್ BOM ರೂಟಿಂಗ್ ಮೂಲಕ ಯಂತ್ರಗಳು ಮತ್ತು ಉಪ-ಜೋಡಣೆಗಳನ್ನು ನೇರವಾಗಿ ಅವುಗಳ ಬಿಡಿ ಭಾಗಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಲಾಗುತ್ತದೆ.",
    "about.feat.docs": "ಸುರಕ್ಷತಾ ದಾಖಲೆ ನಿರ್ವಹಣೆ",
    "about.feat.docs_body": "ಸುರಕ್ಷತಾ SOPಗಳು, ತಾಂತ್ರಿಕ ಕೈಪಿಡಿಗಳು ಮತ್ತು ಬ್ಲೂಪ್ರಿಂಟ್‌ಗಳಿಗಾಗಿ ಸುರಕ್ಷಿತ, ಮೀಸಲಾದ ಸಂಗ್ರಹಣೆ. ಸುರಕ್ಷತೆ-ನಿರ್ಣಾಯಕ ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳನ್ನು ಯಾವಾಗಲೂ ಸ್ವತ್ತು ಪುಟದಿಂದ ನೇರವಾಗಿ ಪ್ರವೇಶಿಸಬಹುದು ಎಂದು ಖಾತರಿಪಡಿಸಲು MIME-ರೀತಿಯ ಮೌಲ್ಯೀಕರಣ ಮತ್ತು ಪ್ರತ್ಯೇಕವಾದ ಡಾಕ್ಯುಮೆಂಟ್ ಪಥಿಂಗ್ ಅನ್ನು ಕಟ್ಟುನಿಟ್ಟಾಗಿ ಜಾರಿಗೊಳಿಸುತ್ತದೆ.",
    "about.feat.inventory": "ಬಿಡಿಭಾಗಗಳ ದಾಸ್ತಾನು ಮತ್ತು ಸ್ವಯಂ ಮರುಕ್ರಮಗೊಳಿಸಿ",
    "about.feat.inventory_body": "ಪೂರ್ಣ ಲಾಜಿಸ್ಟಿಕ್ಸ್ ಡೇಟಾ, ಸ್ಟಾಕ್ ಮಟ್ಟಗಳು ಮತ್ತು ಅನುಸರಣೆ ಕ್ಷೇತ್ರಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ. ಸ್ಟಾಕ್ ವ್ಯಾಖ್ಯಾನಿಸಿದ ಥ್ರೆಶೋಲ್ಡ್‌ಗಳಿಗಿಂತ ಕಡಿಮೆಯಾದಾಗ ಟ್ರಿಗ್ಗರ್ ಮಾಡುವ ಶೂನ್ಯ-ಟಚ್ ಸ್ವಯಂ-ಮರುಕ್ರಮಗೊಳಿಸುವ ವ್ಯವಸ್ಥೆಯನ್ನು ವೈಶಿಷ್ಟ್ಯಗೊಳಿಸುತ್ತದೆ.",
    "about.feat.lines": "ಉತ್ಪಾದನಾ ಮಾರ್ಗಗಳು ಮತ್ತು ಮಳಿಗೆ ಮಹಡಿ ಶ್ರೇಣಿಗಳು",
    "about.feat.lines_body": "ಪೂರ್ಣ ಕಾರ್ಯಾಗಾರದಿಂದ ಸಾಲಿನಿಂದ ಸಲಕರಣೆಗಳ ಕ್ರಮಾನುಗತ ನಿರ್ವಹಣೆ. ಉತ್ಪಾದನಾ ಮಾರ್ಗಗಳು ಯಂತ್ರ ಎಣಿಕೆಗಳು, ಸ್ಥಿತಿ ಟ್ರ್ಯಾಕಿಂಗ್ ಮತ್ತು ಕೆಲಸದ ಆದೇಶಗಳು ಮತ್ತು ಸಲಕರಣೆಗಳಿಗೆ ನೇರವಾದ ಏಕೀಕರಣದೊಂದಿಗೆ ಪ್ರಥಮ ದರ್ಜೆಯ ನಾಗರಿಕರು.",
    "about.feat.modular": "ವಿಭಜಿತ ಮಾಡ್ಯುಲರ್ ಆರ್ಕಿಟೆಕ್ಚರ್",
    "about.feat.modular_body": "ನಿರ್ವಹಣೆ ಮತ್ತು ಭವಿಷ್ಯದ ವಿಸ್ತರಣೆಗಾಗಿ ತಾರ್ಕಿಕ ಡೊಮೇನ್ ಫೋಲ್ಡರ್‌ಗಳಿಗೆ (_mgmt, _maint, _eam, _prod, _logi, _rpt ಇತ್ಯಾದಿ) ಮರುಸಂಘಟನೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ. ಎಲ್ಲಾ ಉಲ್ಲೇಖಗಳು, ಒಳಗೊಂಡಿರುತ್ತದೆ ಮತ್ತು ನ್ಯಾವಿಗೇಶನ್ ಅನ್ನು ನವೀಕರಿಸಲಾಗಿದೆ.",
    "about.feat.pm": "ನಿಗದಿತ ನಿರ್ವಹಣೆ & PM ಕ್ಯಾಲೆಂಡರ್",
    "about.feat.pm_body": "ಪ್ರಿವೆಂಟಿವ್ ನಿರ್ವಹಣೆಗಾಗಿ ಪೂರ್ವಭಾವಿ ಶೆಡ್ಯೂಲಿಂಗ್ ಎಂಜಿನ್ PM. ಮಿತಿಮೀರಿದ ದಿನಚರಿಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ, ಸಸ್ಯ ರಜಾದಿನಗಳಿಗೆ ಕ್ರಿಯಾತ್ಮಕವಾಗಿ ಸರಿಹೊಂದಿಸುತ್ತದೆ ಮತ್ತು ಸಂವಾದಾತ್ಮಕ ಕ್ಯಾಲೆಂಡರ್‌ನಲ್ಲಿ ಕೆಲಸದ ಹೊರೆಗಳನ್ನು ದೃಶ್ಯೀಕರಿಸುತ್ತದೆ.",
    "about.feat.procurement": "ಎಂಡ್-ಟು-ಎಂಡ್ ಪ್ರೊಕ್ಯೂರ್‌ಮೆಂಟ್ (PRs & POs)",
    "about.feat.procurement_body": "ಸಂಪೂರ್ಣ ಸ್ವಾಧೀನ ಸರಪಳಿಯನ್ನು ಸಂಘಟಿಸುತ್ತದೆ. ಆಂತರಿಕ ಖರೀದಿ ವಿನಂತಿಗಳು (PRs) ಮಾರಾಟಗಾರರಿಗೆ ಕಳುಹಿಸಲಾದ ಔಪಚಾರಿಕ ಖರೀದಿ ಆದೇಶಗಳಾಗಿ (POs) ಉಲ್ಬಣಗೊಳ್ಳುತ್ತವೆ, 9 ವಿಭಿನ್ನ PO ಸ್ಥಿತಿಗಳಲ್ಲಿ IATF-ಕಾಂಪ್ಲೈಂಟ್ ಆಡಿಟ್ ಲಾಗ್ ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತವೆ.",
    "about.feat.rbac": "ಪಾತ್ರ-ಆಧಾರಿತ ಪ್ರವೇಶ ನಿಯಂತ್ರಣ RBAC",
    "about.feat.rbac_body": "ಎಂಟರ್‌ಪ್ರೈಸ್ ದರ್ಜೆಯ ಅನುಮತಿ ವ್ಯವಸ್ಥೆಯು ಸಂಪೂರ್ಣ ಭದ್ರತೆಯನ್ನು ಚಾಲನೆ ಮಾಡುತ್ತದೆ. ಗ್ರ್ಯಾನ್ಯುಲರ್ ಮಾಡ್ಯೂಲ್ ಪ್ರವೇಶದಿಂದ Evil Maid ರಕ್ಷಣೆಗೆ ಟಿಕೆಟ್ ಟೇಕ್‌ಓವರ್‌ಗಳು ಮತ್ತು ಕ್ಲೋಸ್‌ಔಟ್‌ಗಳ ಸಮಯದಲ್ಲಿ ಅನಧಿಕೃತ ಸೆಶನ್ ಅಪಹರಣವನ್ನು ತಡೆಯುತ್ತದೆ.",
    "about.feat.tickets": "ಪೂರ್ಣ ಟಿಕೆಟ್ ಜೀವನಚಕ್ರ (ಮುಚ್ಚುವವರೆಗೆ ತೆರೆದಿರುತ್ತದೆ)",
    "about.feat.tickets_body": "ಆರಂಭಿಕ ನೋಂದಾವಣೆಯಿಂದ ತಾಂತ್ರಿಕ ನಿಯೋಜನೆ ಮತ್ತು ಅಂತಿಮ ನಿರ್ಣಯದವರೆಗೆ ಕೈಗಾರಿಕಾ ದೋಷಗಳನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ. ವೇಗದ ಟ್ರ್ಯಾಕ್ ರಿಪೇರಿಗಾಗಿ ನೇರ ಪ್ರವೇಶವನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ.",
    "about.feedback_title": "Psst — got a second?",
    "about.genesis": "WCC ಜೆನೆಸಿಸ್ ಪ್ರೋಟೋಕಾಲ್",
    "about.hosted_by": "ಮೂಲಕ ಹೋಸ್ಟ್ ಮತ್ತು ಚಾಂಪಿಯನ್",
    "about.indykb_blurb": "ನಮ್ಮ ಶ್ರೇಣಿಯೊಳಗೆ ಜ್ಞಾನವನ್ನು ಹಂಚಿಕೊಳ್ಳುವ ತಂತ್ರಜ್ಞರಿಗಾಗಿ ನಕಲಿಸಲಾಗಿದೆ ಮತ್ತು ಪ್ರಪಂಚದಾದ್ಯಂತ ತಮ್ಮ ಉತ್ಪಾದನಾ ಮಾರ್ಗಗಳನ್ನು ಚಲಿಸುವ ಅಗತ್ಯವಿರುವ ಯಾರಿಗಾದರೂ ಉಚಿತವಾಗಿ ಲಭ್ಯವಿದೆ.",
    "about.license_body": "Source-available under Apache License 2.0 with the Commons Clause. Use and modify WCC for your own plant operations. Do not sell the software itself or offer it as a commercial hosted service. Licensor: David Zoltan Csiki. Full text: LICENSE.txt.",
